# NimoOS Agent — offline image. Build context = NimoOS-AI repo root (COPY agent/).
#
# Reproducible/offline tip: pin the base image digest to avoid docker.io re-resolving
# the tag on every build (a re-resolve that lands a different image rebuilds every
# layer below it; an offline environment would just hit a TLS timeout).
# Get the digest on a machine with internet access:
#   docker pull python:3.11-slim
#   docker inspect --format '{{index .RepoDigests 0}}' python:3.11-slim
# Then replace the next line with:  FROM python:3.11-slim@sha256:<digest>

# The egress-proxy binary is precompiled on the [host] (package-agent.sh runs go build
# before docker build), and COPY'd straight into the image here — this avoids a
# multi-stage golang:1.21 image dependency (that base image may not exist on an offline NAS).
FROM python:3.11-slim

# Sandbox runtime + LLM command toolchain (commands use the container's /usr after bwrap --ro-bind /usr)
RUN apt-get update && apt-get install -y --no-install-recommends \
      bubblewrap util-linux tini \
      iproute2 \
      libmagic1 ca-certificates \
      bash coreutils findutils grep sed gawk \
      git curl wget \
      jq ripgrep fd-find \
      unzip zip tar gzip xz-utils \
      file \
 && rm -rf /var/lib/apt/lists/*

# Node (npm/npx) + uv (uvx): stdio MCP server runtime (auto-downloaded when the user
# configures `npx -y ...` / `uvx ...`)
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv

# Point the stdio server's HOME / package cache at a persistent volume so container
# restarts don't re-download (the directory is mkdir'd by main.py at startup)
ENV NIMOOS_MCP_HOME=/var/lib/nimoos/ai/agent/mcp-home
ENV npm_config_cache=/var/lib/nimoos/ai/agent/mcp-home/.npm
ENV UV_CACHE_DIR=/var/lib/nimoos/ai/agent/mcp-home/.uv

# Static ffmpeg (avoids apt pulling in ~200MB of X11/wayland dependencies)
ARG FFMPEG_ARCH=amd64
RUN set -eux; cd /tmp; \
    wget -q "https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-${FFMPEG_ARCH}-static.tar.xz" -O ffmpeg.tar.xz; \
    tar -xf ffmpeg.tar.xz; \
    cp ffmpeg-*-static/ffmpeg ffmpeg-*-static/ffprobe /usr/local/bin/; \
    rm -rf /tmp/ffmpeg*

# Separate the dependency layer from the code layer (key to layer caching): copy only
# requirements.txt and install deps first, then copy the source. This way editing any
# *.py only invalidates the final COPY layer (seconds, zero downloads); the pip layer
# only reinstalls when requirements.txt changes. Baked into the image — the host no
# longer builds a venv.
# PIP_INDEX_URL: defaults to the official source; for mainland-China/slow-network
# builds, pass --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple to speed things up.
ARG PIP_INDEX_URL=https://pypi.org/simple
# 装 lock 文件(定版,无区间可冲突,故不需要 --override)。uv 已在上面的
# "Node + uv" 层装过。requirements.txt / overrides.txt 是源文件,只在重新
# 解析依赖时用到,不进镜像。
# --no-deps:requirements.lock 是 `uv pip compile` 产出的完整传递闭包,安装阶段
# 只需照单物化,不该再重新解析一次依赖图 —— 重新解析会撞上 openai-agents 包元数据
# 里那条 `mcp<2` 声明(该冲突只存在于元数据、不存在于代码,依据见 overrides.txt),
# 即使 lock 里每一行都已是 `==` 精确版本也会被判定为 ResolutionImpossible。
COPY agent/requirements.lock /usr/share/nimoos/agent/requirements.lock
RUN uv pip install --system --no-cache --no-deps -i "${PIP_INDEX_URL}" \
      -r /usr/share/nimoos/agent/requirements.lock
COPY agent/ /usr/share/nimoos/agent/

WORKDIR /usr/share/nimoos/agent
ENV AGENT_DB_PATH=/var/lib/nimoos/ai/agent/agent.db
EXPOSE 8282

# /etc/localtime as a REGULAR FILE (same UTC content the symlink pointed at).
# The base image ships it as a symlink to /usr/share/zoneinfo/Etc/UTC, and
# docker resolves a bind mount's target through symlinks: mounting the host's
# tzfile at /etc/localtime therefore overwrote the container's Etc/UTC — and
# /usr/share/zoneinfo/UTC, which links to it — so `TZ=UTC date` and
# ZoneInfo("UTC") both reported the host's zone. Measured on 118. The agent
# runs the user's shell commands in this container, so a UTC that is not UTC is
# a silent correctness bug in anything they schedule or convert.
# docker-compose.yml avoids the trap by mounting at a neutral path; this makes
# the trap not exist, for whoever mounts /etc/localtime next.
RUN rm -f /etc/localtime && cp /usr/share/zoneinfo/Etc/UTC /etc/localtime

# egress-proxy: static binary precompiled on the host (CGO_ENABLED=0), generated by package-agent.sh before the build
COPY deploy/agent/egress-proxy/egress-proxy /usr/local/bin/egress-proxy
RUN chmod +x /usr/local/bin/egress-proxy

# tini as PID 1 reaps orphan/zombie processes spawned by bwrap
ENTRYPOINT ["/usr/bin/tini", "--", "python", "main.py"]
