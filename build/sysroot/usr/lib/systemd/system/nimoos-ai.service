[Unit]
After=nimoos-gateway.service nimoos-message-bus.service
Description=NimoOS AI Service

[Service]
ExecStartPre=/usr/bin/nimoos-ai -v
ExecStart=/usr/bin/nimoos-ai -c /etc/nimoos/ai.conf
PIDFile=/var/run/nimoos/ai.pid
Restart=always
Type=notify
# The Go gateway normally stays under 300MB; this cap guards against an unknown leak taking down the whole machine (2026-07-28 OOM postmortem).
MemoryAccounting=yes
MemoryHigh=2G
MemoryMax=3G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
