[Unit]
Description=NimoOS OpenVINO Model Server (OVMS)
After=network-online.target
Wants=network-online.target

[Service]
# Reset config.json to an empty read-only config template before every start (including
# boot and crash auto-restart), ensuring OVMS itself never auto-loads any model on
# startup — config.json is the file nimoos-ai uses to persist "currently resident
# models"; if not cleared after a full machine reboot, OVMS would auto-load whatever
# was in the last session (and dual-GPU simultaneous loading during the boot memory
# spike could trigger an OOM loop). Models should only be mounted via nimoos-ai's
# on-demand loading (EnsureLoaded) when actually requested by a user/agent.
# Use cp to copy the template rather than writing the file inline via shell: this avoids
# systemd's secondary parsing of quotes/% from corrupting the JSON.
ExecStartPre=/bin/mkdir -p /var/lib/nimoos/ai/openvino
ExecStartPre=/bin/cp -f /usr/share/nimoos/openvino/empty-config.json /var/lib/nimoos/ai/openvino/config.json
# OVMS binary path follows deploy-openvino.sh's install location; defaults to /opt/ovms/bin/ovms
ExecStart=/opt/ovms/bin/ovms --config_path /var/lib/nimoos/ai/openvino/config.json --rest_port 9100 --rest_bind_address 127.0.0.1
# Accessing the Intel GPU requires being in the render/video groups
SupplementaryGroups=render video
Restart=always
RestartSec=5
# OVMS depends on shared libraries under its install directory
Environment=LD_LIBRARY_PATH=/opt/ovms/lib

[Install]
WantedBy=multi-user.target
