[common]
RuntimePath = /var/run/nimoos
DataPath = /var/lib/nimoos/ai
LogPath = /var/log/nimoos

[ai]
MasterKeyPath = /etc/nimoos/ai_master.key

[agent]
AgentURL = http://127.0.0.1:8282
AgentTimeout = 60
OllamaURL = http://127.0.0.1:11434

[openvino]
URL = http://127.0.0.1:9100
Enabled = true
# Resident devices (comma-separated); the first one is the default when @device is
# omitted. By default only the discrete GPU.1 stays resident; to also keep the
# integrated GPU resident, write "GPU.1,GPU.0" (the iGPU eats 32GB of shared memory,
# so this is tight).
Devices = GPU.1
# Max number of models resident at once (mirrors Ollama's OLLAMA_MAX_LOADED_MODELS);
# constrained by VRAM, excess is evicted LRU-style.
MaxLoadedModels = 3
# Auto-unload after this many idle minutes to free VRAM (mirrors Ollama's keep_alive
# default of 5 minutes); 0 = never unload.
IdleTTLMinutes = 5

# Attachment limits (override via env NIMOOS_MAX_ATTACHMENT_SIZE etc.)
MaxAttachmentSize         = 524288000     ; 500 MB, global upper bound
MaxImageAttachmentSize    = 20971520      ; 20 MB, image kind only
MaxAttachmentsPerSession  = 50
MaxAttachmentTextChars    = 32768         ; per read_attachment() call
FFProbeTimeout            = 5             ; seconds
AttachmentGCAge           = 86400         ; seconds, draft cleanup threshold
